# .env 模板 — 复制为 .env 并填入真实密钥

# LLM (OpenAI 兼容接口，可指向 OpenAI / 通义千问 / DeepSeek 等)
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# Azure Speech Service
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=eastasia

# Tesseract OCR (可选，留空使用系统默认)
TESSERACT_CMD=
OCR_LANGUAGE=eng

# 数据库 (生产环境切换 PostgreSQL)
# DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/ai_language_platform
